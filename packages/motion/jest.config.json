{
    "transform": {
        "^.+\\.tsx?$": [
            "ts-jest",
            {
                "tsconfig": "<rootDir>/../tsconfig.test.json"
            }
        ],
        "^.+\\.jsx?$": [
            "ts-jest",
            {
                "tsconfig": "<rootDir>/../tsconfig.test.json"
            }
        ]
    },
    "testEnvironment": "jsdom",
    "rootDir": "src",
    "testMatch": ["**/__tests__/**/*.test.(js|ts)?(x)"],
    "reporters": [
        "default",
        [
            "jest-junit",
            {
                "outputDirectory": "../../test_reports",
                "outputName": "motion.xml"
            }
        ]
    ],
    "moduleNameMapper": {
        "^remix/component$": "@remix-run/component",
        "^remix/component/(.*)$": "@remix-run/component/$1"
    },
    "transformIgnorePatterns": [
        "/node_modules/(?!@remix-run)"
    ]
}
